# PartnerOpsAI Environment Variables

# Required for development and production

# Supabase (Database, Auth, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Provider (choose one, or use Ollama locally)
# Option 1: Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434

# Option 2: OpenAI
OPENAI_API_KEY=sk-...

# Option 3: Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Vercel / Deployment
VERCEL_ENV=development

# Optional: Analytics / Monitoring
# DATADOG_API_KEY=
# SENTRY_DSN=

# Notes:
# - Copy this file to .env.local
# - .env.local is gitignored (do not commit)
# - For production, set these in Vercel dashboard
# - SUPABASE_SERVICE_ROLE_KEY should NEVER be exposed to client
# - Use NEXT_PUBLIC_ prefix only for values safe to expose in browser
