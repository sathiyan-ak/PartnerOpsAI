# PartnerOpsAI Backend Environment Variables

# Database Configuration
# PostgreSQL connection string for backend
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/partneropsa_test

# Server Configuration
# Host and port for FastAPI server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Environment
# Options: development, production, staging
ENVIRONMENT=development

# Optional: LLM Provider (for future AI features)
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Notes:
# - Copy this file to .env.local
# - .env.local is gitignored (do not commit)
# - For production, update DATABASE_URL with production credentials
# - Use strong passwords in production
# - Never commit .env files with real credentials
